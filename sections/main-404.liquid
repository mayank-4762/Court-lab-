<div style="max-width: 800px; margin: 100px auto; padding: 40px 20px; text-align: center; background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px;">
  <div style="font-family: monospace; font-size: 12px; color: #ccff00; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 8px;">404 ERROR</div>
  <h1 style="font-size: 2.5rem; font-weight: 800; color: #ffffff; margin: 0 0 16px 0;">PAGE NOT FOUND</h1>
  <p style="color: #a1a1aa; margin: 0 0 32px 0;">The requested page or court apparel route does not exist.</p>
  <a href="{{ routes.root_url }}" style="display: inline-block; background: #ffffff; color: #000000; padding: 12px 24px; border-radius: 10px; font-family: monospace; font-size: 12px; font-weight: bold; text-decoration: none; text-transform: uppercase;">RETURN TO HOMEPAGE</a>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
