<div style="max-width: 1280px; margin: 0 auto; padding: 60px 24px;">
  <!-- Section Title -->
  <div style="display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px; margin-bottom: 40px;">
    <div>
      <div style="font-family: monospace; font-size: 11px; color: #ccff00; text-transform: uppercase; letter-spacing: 2px;">PERFORMANCE CATALOG</div>
      <h2 style="font-size: 2rem; font-weight: 800; color: #ffffff; text-transform: uppercase; margin: 4px 0 0 0;">{{ section.settings.title }}</h2>
    </div>
    <a href="{{ routes.all_products_collection_url }}" style="color: #a1a1aa; text-decoration: none; font-family: monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 1px;">VIEW ALL PRODUCTS &rarr;</a>
  </div>

  <!-- Products Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    {% assign collection_handle = section.settings.collection | default: 'all' %}
    {% for product in collections[collection_handle].products limit: section.settings.products_to_show %}
      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px; display: flex; flex-col; justify-content: space-between; transition: border-color 0.3s;">
        <div>
          <!-- Image -->
          <a href="{{ product.url }}" style="display: block; aspect-ratio: 1; overflow: hidden; border-radius: 12px; background: #0b0c0e; margin-bottom: 16px;">
            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.title }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
            {% else %}
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #52525b; font-family: monospace; font-size: 12px;">COURT LAB PRODUCT</div>
            {% endif %}
          </a>

          <!-- Badge & Title -->
          <div style="font-family: monospace; font-size: 10px; color: #10b981; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">LAB TESTED</div>
          <h3 style="font-size: 1.125rem; font-weight: 700; color: #ffffff; margin: 0 0 8px 0;">
            <a href="{{ product.url }}" style="color: #ffffff; text-decoration: none;">{{ product.title }}</a>
          </h3>
          <p style="color: #a1a1aa; font-size: 0.875rem; margin: 0 0 16px 0; line-height: 1.4;">{{ product.description | strip_html | truncate: 80 }}</p>
        </div>

        <!-- Price & Action -->
        <div style="display: flex; align-items: center; justify-content: space-between; border-t: 1px solid rgba(255,255,255,0.08); pt: 16px; margin-top: 16px;">
          <span style="font-family: monospace; font-size: 1.125rem; font-weight: 700; color: #ffffff;">{{ product.price | money }}</span>
          <a href="{{ product.url }}" style="background: #ffffff; color: #000000; padding: 8px 16px; border-radius: 8px; font-family: monospace; font-size: 11px; font-weight: bold; text-decoration: none; text-transform: uppercase;">VIEW DETAILS</a>
        </div>
      </div>
    {% else %}
      <!-- Sample Products when collection is empty in preview -->
      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px;">
        <div style="aspect-ratio: 1; background: #0b0c0e; border-radius: 12px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; font-family: monospace; color: #52525b; font-size: 12px;">PRO-ELITE COURT TEE</div>
        <div style="font-family: monospace; font-size: 10px; color: #10b981; margin-bottom: 4px;">AERO-VENT MESH</div>
        <h3 style="color: #ffffff; font-size: 1.125rem; margin: 0 0 8px 0;">Pro-Elite Court Tee</h3>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin-bottom: 16px;">4-way stretch, active cooling micro-vents.</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-family: monospace; color: #ffffff; font-weight: bold;">$68.00</span>
          <span style="background: #ffffff; color: #000; padding: 6px 12px; border-radius: 6px; font-family: monospace; font-size: 10px; font-weight: bold;">SELECT OPTIONS</span>
        </div>
      </div>

      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px;">
        <div style="aspect-ratio: 1; background: #0b0c0e; border-radius: 12px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; font-family: monospace; color: #52525b; font-size: 12px;">APEX COMPRESSION SHORT</div>
        <div style="font-family: monospace; font-size: 10px; color: #ccff00; margin-bottom: 4px;">KINETIC LINER</div>
        <h3 style="color: #ffffff; font-size: 1.125rem; margin: 0 0 8px 0;">Apex Compression Short</h3>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin-bottom: 16px;">Integrated ball loops & sweat-proof liner.</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-family: monospace; color: #ffffff; font-weight: bold;">$78.00</span>
          <span style="background: #ffffff; color: #000; padding: 6px 12px; border-radius: 6px; font-family: monospace; font-size: 10px; font-weight: bold;">SELECT OPTIONS</span>
        </div>
      </div>

      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 20px;">
        <div style="aspect-ratio: 1; background: #0b0c0e; border-radius: 12px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; font-family: monospace; color: #52525b; font-size: 12px;">PRO-VORTEX POLO</div>
        <div style="font-family: monospace; font-size: 10px; color: #10b981; margin-bottom: 4px;">SILVER-ION THREAD</div>
        <h3 style="color: #ffffff; font-size: 1.125rem; margin: 0 0 8px 0;">Pro-Vortex Aero Polo</h3>
        <p style="color: #a1a1aa; font-size: 0.875rem; margin-bottom: 16px;">Magnetic placket and active spine ventilation.</p>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-family: monospace; color: #ffffff; font-weight: bold;">$84.00</span>
          <span style="background: #ffffff; color: #000; padding: 6px 12px; border-radius: 6px; font-family: monospace; font-size: 10px; font-weight: bold;">SELECT OPTIONS</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "FEATURED COURT GEAR"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
