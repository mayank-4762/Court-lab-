<div style="background: #0b0c0e; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); padding: 80px 24px;">
  <div style="max-width: 1280px; margin: 0 auto;">
    <div style="text-align: center; max-width: 640px; margin: 0 auto 60px;">
      <div style="font-family: monospace; font-size: 11px; color: #ccff00; text-transform: uppercase; letter-spacing: 2px;">TEXTILE INNOVATION</div>
      <h2 style="font-size: 2.25rem; font-weight: 800; color: #ffffff; text-transform: uppercase; margin: 8px 0;">{{ section.settings.heading }}</h2>
      <p style="color: #a1a1aa; font-size: 1rem; margin: 0;">{{ section.settings.subheading }}</p>
    </div>

    <!-- 3 Tech Pillar Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 32px;">
        <div style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #10b981; font-family: monospace; font-weight: bold; margin-bottom: 20px;">01</div>
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 12px 0;">Micro-Vent Airflow Grid</h3>
        <p style="color: #a1a1aa; line-height: 1.6; font-size: 0.925rem; margin: 0;">Laser-cut micro-perforations along thermal zones flush out trapped body heat and accelerate evaporative cooling during long rallies.</p>
      </div>

      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 32px;">
        <div style="width: 48px; height: 48px; background: rgba(204, 255, 0, 0.15); border: 1px solid #ccff00; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #ccff00; font-family: monospace; font-weight: bold; margin-bottom: 20px;">02</div>
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 12px 0;">4-Way Kinetic Matrix</h3>
        <p style="color: #a1a1aa; line-height: 1.6; font-size: 0.925rem; margin: 0;">Engineered 82/18 Poly-Spandex blend provides 360-degree flexibility for rapid lateral changes, overhead dunks, and deep kitchen reaches.</p>
      </div>

      <div style="background: #121318; border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 32px;">
        <div style="width: 48px; height: 48px; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255,255,255,0.3); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #ffffff; font-family: monospace; font-weight: bold; margin-bottom: 20px;">03</div>
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #ffffff; margin: 0 0 12px 0;">Zero-Chafe Flatlock Seams</h3>
        <p style="color: #a1a1aa; line-height: 1.6; font-size: 0.925rem; margin: 0;">Ultrasonic welded and flatlocked seam construction eliminates skin friction, allowing frictionless movement during peak high-intensity sets.</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Anatomy Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ANATOMY OF COURT APPAREL"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Biomechanical engineering optimized for court movement."
    }
  ],
  "presets": [
    {
      "name": "Anatomy Section"
    }
  ]
}
{% endschema %}
