<footer style="background-color: #08080a; border-top: 1px solid rgba(255, 255, 255, 0.1); padding: 60px 24px 40px; color: #a1a1aa;">
  <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; margin-bottom: 40px;">
    <!-- Brand Info -->
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
        <div style="width: 28px; height: 28px; background: #ccff00; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: 900; color: #000; font-size: 14px; font-family: monospace;">CL</div>
        <span style="font-family: monospace; font-size: 16px; font-weight: 800; color: #fff; letter-spacing: 2px;">COURT<span style="color: #ccff00;">LAB</span></span>
      </div>
      <p style="font-size: 0.875rem; line-height: 1.6; color: #71717a;">Scientific apparel engineering built specifically for high-velocity pickleball performance.</p>
    </div>

    <!-- Quick Links -->
    <div>
      <h4 style="font-family: monospace; font-size: 11px; color: #ffffff; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 16px 0;">NAVIGATION</h4>
      <ul style="list-style: none; padding: 0; margin: 0; font-family: monospace; font-size: 12px; display: flex; flex-direction: column; gap: 10px;">
        <li><a href="{{ routes.all_products_collection_url }}" style="color: #71717a; text-decoration: none;">COLLECTION CATALOG</a></li>
        <li><a href="/pages/order-tracking" style="color: #ccff00; text-decoration: none; font-weight: bold;">TRACK SHIPMENT</a></li>
        <li><a href="/pages/contact" style="color: #71717a; text-decoration: none;">CONTACT US</a></li>
        <li><a href="/pages/about" style="color: #71717a; text-decoration: none;">LAB SCIENCE</a></li>
        <li><a href="{{ routes.cart_url }}" style="color: #71717a; text-decoration: none;">YOUR CART</a></li>
      </ul>
    </div>

    <!-- Lab Specs -->
    <div>
      <h4 style="font-family: monospace; font-size: 11px; color: #ffffff; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 0 16px 0;">LAB SPECIFICATIONS</h4>
      <div style="font-family: monospace; font-size: 11px; color: #71717a; display: flex; flex-direction: column; gap: 8px;">
        <div>ISO-9001 TESTED TEXTILES</div>
        <div>SILVER-ION ANTIMICROBIAL</div>
        <div>ACTIVE VAPOR EVAPORATION</div>
      </div>
    </div>
  </div>

  <div style="max-width: 1280px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 24px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; font-family: monospace; font-size: 11px; color: #52525b;">
    <div>&copy; {{ 'now' | date: '%Y' }} COURT LAB. ALL RIGHTS RESERVED.</div>
    <div>POWERED BY SHOPIFY • HIGH-PERFORMANCE PICKLEBALL APPAREL</div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
